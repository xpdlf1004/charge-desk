# Claude API key (required for the chat)
ANTHROPIC_API_KEY=
# mock = built-in demo store (default), sandbox = your PayPal sandbox merchant account
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: override the model
# CLAUDE_MODEL=claude-opus-5-5
# Stop the chat for the day once AI spend reaches this many USD
DAILY_BUDGET_USD=3
